{
  "name": "@aegisforge/flowd",
  "version": "0.1.0",
  "private": true,
  "description": "AegisForge workflow daemon: soft-workflow engine (vendored from dsh-workflow-lite, MIT) + Claude Agent SDK runner + Fastify HTTP surface",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "main": "lib/index.mjs",
