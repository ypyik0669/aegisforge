    "fastify": "^5.2.0",
    "fflate": "^0.8.3",
    "markdown-it": "^15.0.2",
    "markdown-it-cjk-friendly": "^3.0.0",
    "pathe": "^2.0.3",
    "yaml": "^2.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/node": "^22.19.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
